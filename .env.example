# Socialscrubb Environment Configuration

# Ollama Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b-instruct

# Application Configuration
DATABASE_PATH=./data/socialscrubb.db
UPLOAD_PATH=./uploads
PORT=3000

# Analysis Settings
ANALYSIS_BATCH_SIZE=10
ANALYSIS_CONCURRENT_REQUESTS=2

# Privacy Settings (do not enable without explicit user consent)
ENABLE_CLOUD_AI=false
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
